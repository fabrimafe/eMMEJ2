library(data.table)
library(svglite)
library(ggplot2)
library(patchwork)   # install.packages("patchwork") se non è installato

base_dir <- "C:/Users/web/Desktop/plot_loop/EM_filtered_same_indel/"
out_dir  <- base_dir

# dimensioni (in pollici) di ogni sotto-grafico nella figura combinata
width_per_plot <- 7
height_fig     <- 7


# ---------------------------------------------------------------------------
# Costruisce il plot di UN dataset (restituisce il ggplot, non salva nulla)
# ---------------------------------------------------------------------------
build_plot <- function(name,
                       base   = base_dir,
                       pi_col = "pi_DD") {

  mh_num <- as.integer(sub(".*_MH([0-9]+)$", "\\1", name))

  # cartella del dataset; usa la sottocartella "files" se esiste
  folder <- file.path(base, name)
  dir    <- if (dir.exists(file.path(folder, "files"))) file.path(folder, "files") else folder

  pattern <- paste0("^1000_", name, "_.*_prop[0-9.]+_set[0-9]+_EM_paramaters_estimated$")
  files <- list.files(dir, pattern = pattern, full.names = TRUE)

  if (length(files) == 0) {
    warning("Nessun file trovato per ", name, " in ", dir)
    return(NULL)
  }

  DT <- rbindlist(
    lapply(files, function(f) {
      d  <- fread(f, sep = "\t", header = TRUE)
      nm <- basename(f)
      d$prop <- as.numeric(sub(".*_prop([0-9.]+)_set.*", "\\1", nm))
      d$set  <- as.integer(sub(".*_set([0-9]+)_EM.*", "\\1", nm))
      d
    }),
    fill = TRUE
  )

  if (!pi_col %in% names(DT)) {
    warning("Colonna ", pi_col, " assente in ", name)
    return(NULL)
  }

  setorder(DT, prop, set)
  DT[, prop_f := factor(prop, levels = sort(unique(prop)))]
  DT[, est := get(pi_col)]
  DT[, err := est - prop]

  panel_levels <- c(paste("Estimated", sub("^pi_", "", pi_col), "proportion"), "Error")

  dat_all <- rbind(
    DT[, .(prop_f, prop, y = est, panel = factor(panel_levels[1], levels = panel_levels))],
    DT[, .(prop_f, prop, y = err, panel = factor(panel_levels[2], levels = panel_levels))]
  )

  ref_true <- DT[, .(y = mean(prop)), by = prop_f]
  ref_true[, panel := factor(panel_levels[1], levels = panel_levels)]

  ggplot(dat_all, aes(x = prop_f, y = y)) +
    geom_hline(data = data.frame(panel = factor(panel_levels[2], levels = panel_levels), yint = 0),
               aes(yintercept = yint), colour = "red", linewidth = 0.8, linetype = "dashed") +
    geom_violin(fill = "grey85", colour = "grey40", scale = "width", trim = TRUE, width = 0.7) +
    geom_jitter(width = 0.08, height = 0, size = 2.2, alpha = 0.8) +
    stat_summary(fun = mean, geom = "point", shape = 95, size = 10, colour = "blue") +
    geom_point(data = ref_true, aes(x = prop_f, y = y), shape = 95, size = 12, colour = "red") +
    facet_wrap(~ panel, ncol = 1, scales = "free_y", strip.position = "left") +
    scale_y_continuous(expand = expansion(mult = 0.05)) +
    labs(x = paste("Simulated", sub("^pi_", "", pi_col), "Proportion"),
         y = NULL,
         title = paste0("MH", mh_num)) +
    theme_bw() +
    theme(strip.placement = "outside",
          strip.background = element_blank(),
          strip.text.y.left = element_text(angle = 90, size = 11))
}


# ---------------------------------------------------------------------------
# Rileva i dataset (cartelle *_MH<n>) e li raggruppa per meccanismo
# ---------------------------------------------------------------------------
datasets <- list.dirs(base_dir, recursive = FALSE, full.names = FALSE)
datasets <- grep("_MH[0-9]+$", datasets, value = TRUE)   # es. "DS_MH2", "DS_MH3", ...

if (length(datasets) == 0) {
  stop("Nessuna cartella *_MH<n> trovata in ", base_dir)
}

mech_of <- sub("_MH[0-9]+$", "", datasets)
mh_of   <- as.integer(sub(".*_MH([0-9]+)$", "\\1", datasets))

# ordina per meccanismo e poi per lunghezza MH (MH2, MH3, MH4, ... in ordine numerico)
ord      <- order(mech_of, mh_of)
datasets <- datasets[ord]
mech_of  <- mech_of[ord]

by_mech <- split(datasets, factor(mech_of, levels = unique(mech_of)))
print(by_mech)   # controlla il raggruppamento


# ---------------------------------------------------------------------------
# Un plot per ogni dataset, poi UNA figura per meccanismo
# ---------------------------------------------------------------------------
plots <- lapply(names(by_mech), function(m) {
  pl <- lapply(by_mech[[m]], build_plot, pi_col = paste0("pi_", m))
  names(pl) <- by_mech[[m]]
  pl[!vapply(pl, is.null, logical(1))]   # scarta i dataset senza dati
})
names(plots) <- names(by_mech)

for (m in names(plots)) {
  pl <- plots[[m]]
  if (length(pl) == 0) next

  fig <- wrap_plots(pl, nrow = 1) +
    plot_annotation(title = paste("Proportion estimation and error of", m))

  #ggsave(file.path(out_dir, paste0("Plot_", m, ".pdf")), fig,
         #width = width_per_plot * length(pl), height = height_fig)
  ggsave(file.path(out_dir, paste0("Plot_", m, ".svg")), fig,
         width = width_per_plot * length(pl), height = height_fig)
}


